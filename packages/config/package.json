{
  "name": "@rituvia/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./brand": {
      "types": "./src/brand.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./feature-flags": {
      "types": "./src/feature-flags.ts",
      "import": "./dist/feature-flags.js",
      "default": "./dist/feature-flags.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
