generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model SeedManifest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetKey     String   @map("dataset_key") @db.VarChar(100)
  version        Int
  checksumSha256 String   @map("checksum_sha256") @db.Char(64)
  isSynthetic    Boolean  @default(true) @map("is_synthetic")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([datasetKey, version], map: "seed_manifest_dataset_key_version_key")
  @@map("seed_manifest")
}

model FeatureFlagVersion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registryVersion   Int       @map("registry_version")
  flagKey           String    @map("flag_key") @db.VarChar(100)
  version           Int
  state             String    @default("off") @db.VarChar(16)
  countryCodes      String[]  @default([]) @map("country_codes")
  localeTags        String[]  @default([]) @map("locale_tags")
  effectiveAt       DateTime  @map("effective_at") @db.Timestamptz(6)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  changeReference   String    @map("change_reference") @db.VarChar(200)
  approvalReference String?   @map("approval_reference") @db.VarChar(200)
  actorId           String    @map("actor_id") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([registryVersion, flagKey, version], map: "feature_flag_version_registry_flag_key_version_key")
  @@index([registryVersion, flagKey, effectiveAt], map: "feature_flag_version_lookup_idx")
  @@map("feature_flag_version")
}

model CountryPolicyVersion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaVersion     String    @map("schema_version") @db.VarChar(100)
  version           String    @unique(map: "country_policy_version_version_key") @db.VarChar(100)
  supersedesVersion String?   @unique(map: "country_policy_version_supersedes_version_key") @map("supersedes_version") @db.VarChar(100)
  countryCode       String    @map("country_code") @db.Char(2)
  environment       String    @db.VarChar(16)
  status            String    @db.VarChar(16)
  approvalMode      String    @map("approval_mode") @db.VarChar(16)
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveUntil    DateTime? @map("effective_until") @db.Timestamptz(6)
  nextReviewAt      DateTime  @map("next_review_at") @db.Timestamptz(6)
  legalReference    String    @map("legal_reference") @db.VarChar(200)
  ownerReference    String    @map("owner_reference") @db.VarChar(200)
  providerReference String    @map("provider_reference") @db.VarChar(200)
  actorId           String    @map("actor_id") @db.VarChar(100)
  policyDocument    Json      @map("policy_document") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([environment, countryCode, effectiveFrom], map: "country_policy_version_lookup_idx")
  @@map("country_policy_version")
}

model CatalogVersion {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaVersion        String           @map("schema_version") @db.VarChar(100)
  version              String           @unique(map: "catalog_version_version_key") @db.VarChar(100)
  supersedesVersion    String?          @unique(map: "catalog_version_supersedes_version_key") @map("supersedes_version") @db.VarChar(100)
  environment          String           @db.VarChar(16)
  status               String           @db.VarChar(16)
  approvalMode         String           @map("approval_mode") @db.VarChar(16)
  defaultLocale        String           @map("default_locale") @db.VarChar(35)
  supportedLocales     String[]         @map("supported_locales") @db.VarChar(35)
  effectiveFrom        DateTime         @map("effective_from") @db.Timestamptz(6)
  effectiveUntil       DateTime?        @map("effective_until") @db.Timestamptz(6)
  nextReviewAt         DateTime         @map("next_review_at") @db.Timestamptz(6)
  sourceReference      String           @map("source_reference") @db.VarChar(300)
  sourceChecksumSha256 String           @map("source_checksum_sha256") @db.Char(64)
  ownerReference       String           @map("owner_reference") @db.VarChar(200)
  actorId              String           @map("actor_id") @db.VarChar(100)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  products             CatalogProduct[]

  @@index([environment, effectiveFrom], map: "catalog_version_lookup_idx")
  @@map("catalog_version")
}

model CatalogProduct {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogVersion       String                       @map("catalog_version") @db.VarChar(100)
  code                 String                       @db.VarChar(100)
  version              String                       @db.VarChar(100)
  kind                 String                       @db.VarChar(32)
  status               String                       @db.VarChar(16)
  fulfillmentCode      String                       @map("fulfillment_code") @db.VarChar(100)
  creditsGranted       Int?                         @map("credits_granted")
  creditsCost          Int?                         @map("credits_cost")
  creditsPerMonth      Int?                         @map("credits_per_month")
  subscriptionInterval String?                      @map("subscription_interval") @db.VarChar(16)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  catalog              CatalogVersion               @relation(fields: [catalogVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  localizations        CatalogProductLocalization[]
  prices               CatalogPrice[]

  @@unique([catalogVersion, code, version], map: "catalog_product_identity_key")
  @@index([catalogVersion, status, kind, code], map: "catalog_product_lookup_idx")
  @@map("catalog_product")
}

model CatalogProductLocalization {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogVersion String         @map("catalog_version") @db.VarChar(100)
  productCode    String         @map("product_code") @db.VarChar(100)
  productVersion String         @map("product_version") @db.VarChar(100)
  locale         String         @db.VarChar(35)
  title          String         @db.VarChar(160)
  description    String         @db.VarChar(1000)
  exactContents  String[]       @map("exact_contents") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  product        CatalogProduct @relation(fields: [catalogVersion, productCode, productVersion], references: [catalogVersion, code, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([catalogVersion, productCode, productVersion, locale], map: "catalog_product_localization_identity_key")
  @@index([catalogVersion, locale, productCode], map: "catalog_product_localization_lookup_idx")
  @@map("catalog_product_localization")
}

model CatalogPrice {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogVersion      String         @map("catalog_version") @db.VarChar(100)
  priceId             String         @map("price_id") @db.VarChar(200)
  version             String         @db.VarChar(100)
  productCode         String         @map("product_code") @db.VarChar(100)
  productVersion      String         @map("product_version") @db.VarChar(100)
  status              String         @db.VarChar(16)
  currencyCode        String         @map("currency_code") @db.Char(3)
  amountMinor         Int            @map("amount_minor")
  billingInterval     String         @map("billing_interval") @db.VarChar(16)
  countryCodes        String[]       @map("country_codes") @db.Char(2)
  providerEligibility String[]       @map("provider_eligibility") @db.VarChar(32)
  taxCategory         String         @map("tax_category") @db.VarChar(100)
  refundPolicyVersion String         @map("refund_policy_version") @db.VarChar(100)
  effectiveFrom       DateTime       @map("effective_from") @db.Timestamptz(6)
  effectiveUntil      DateTime?      @map("effective_until") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  product             CatalogProduct @relation(fields: [catalogVersion, productCode, productVersion], references: [catalogVersion, code, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([catalogVersion, priceId, version], map: "catalog_price_identity_key")
  @@index([catalogVersion, productCode, currencyCode, effectiveFrom], map: "catalog_price_lookup_idx")
  @@map("catalog_price")
}

model CommercialOrderV2 {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId              String    @unique(map: "commercial_order_v2_public_id_key") @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  status                String    @default("created") @db.VarChar(24)
  currencyCode          String    @map("currency_code") @db.Char(3)
  subtotalMinor         Int       @map("subtotal_minor")
  taxMinor              Int       @default(0) @map("tax_minor")
  totalMinor            Int       @map("total_minor")
  refundedMinor         Int       @default(0) @map("refunded_minor")
  countryCode           String    @map("country_code") @db.Char(2)
  countryPolicyVersion  String    @map("country_policy_version") @db.VarChar(100)
  catalogVersion        String    @map("catalog_version") @db.VarChar(100)
  priceId               String    @map("price_id") @db.VarChar(200)
  priceVersion          String    @map("price_version") @db.VarChar(100)
  termsVersion          String    @map("terms_version") @db.VarChar(100)
  refundPolicyVersion   String    @map("refund_policy_version") @db.VarChar(100)
  idempotencyKeyVersion String    @map("idempotency_key_version") @db.VarChar(100)
  idempotencyKeyHash    Bytes     @map("idempotency_key_hash")
  canonicalRequestHash  Bytes     @map("canonical_request_hash")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(6)
  refundRequestedAt     DateTime? @map("refund_requested_at") @db.Timestamptz(6)
  refundedAt            DateTime? @map("refunded_at") @db.Timestamptz(6)
  paymentStateVersion   Int       @default(0) @map("payment_state_version")

  @@unique([userId, idempotencyKeyVersion, idempotencyKeyHash], map: "commercial_order_v2_user_idempotency_key")
  @@unique([id, publicId], map: "commercial_order_v2_id_public_id_key")
  @@unique([id, userId], map: "commercial_order_v2_id_user_key")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "commercial_order_v2_user_created_idx")
  @@map("commercial_order_v2")
}

model CommercialOrderItemV2 {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String   @unique(map: "commercial_order_item_v2_order_key") @map("order_id") @db.Uuid
  catalogVersion        String   @map("catalog_version") @db.VarChar(100)
  productCode           String   @map("product_code") @db.VarChar(100)
  productVersion        String   @map("product_version") @db.VarChar(100)
  quantity              Int      @default(1) @db.SmallInt
  unitAmountMinor       Int      @map("unit_amount_minor")
  totalMinor            Int      @map("total_minor")
  exactContentsSnapshot String[] @map("exact_contents_snapshot") @db.VarChar(500)
  fulfillmentKind       String   @map("fulfillment_kind") @db.VarChar(24)
  fulfillmentCode       String   @map("fulfillment_code") @db.VarChar(100)
  creditsGranted        Int?     @map("credits_granted")
  creditsPerMonth       Int?     @map("credits_per_month")

  @@index([catalogVersion, productCode, productVersion], map: "commercial_order_item_v2_product_idx")
  @@map("commercial_order_item_v2")
}

model CommercialPaymentAttemptV2 {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String    @map("order_id") @db.Uuid
  provider                String    @db.VarChar(32)
  environment             String    @db.VarChar(16)
  providerAccountFingerprint String? @map("provider_account_fingerprint") @db.VarChar(128)
  attemptNumber           Int       @map("attempt_number") @db.SmallInt
  state                   String    @default("created") @db.VarChar(24)
  providerCheckoutId      String?   @map("provider_checkout_id") @db.VarChar(255)
  providerCheckoutUrl     String?   @map("provider_checkout_url") @db.Text
  providerPaymentIntentId String?   @map("provider_payment_intent_id") @db.VarChar(255)
  expectedNetwork         String?   @map("expected_network") @db.VarChar(32)
  expectedAsset           String?   @map("expected_asset") @db.VarChar(32)
  amountMinor             Int       @map("amount_minor")
  currencyCode            String    @map("currency_code") @db.Char(3)
  idempotencyKeyVersion   String    @map("idempotency_key_version") @db.VarChar(100)
  idempotencyKeyHash      Bytes     @map("idempotency_key_hash")
  canonicalRequestHash    Bytes     @map("canonical_request_hash")
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([orderId, attemptNumber], map: "commercial_payment_attempt_v2_order_number_key")
  @@unique([orderId, idempotencyKeyVersion, idempotencyKeyHash], map: "commercial_payment_attempt_v2_idempotency_key")
  @@unique([provider, environment, providerCheckoutId], map: "commercial_payment_attempt_v2_checkout_key")
  @@unique([provider, environment, providerPaymentIntentId], map: "commercial_payment_attempt_v2_intent_key")
  @@unique([id, orderId], map: "commercial_payment_attempt_v2_id_order_key")
  @@index([orderId, state, id], map: "commercial_payment_attempt_v2_order_state_idx")
  @@map("commercial_payment_attempt_v2")
}

model CommercialPaymentEventV2 {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                   String    @db.VarChar(32)
  environment                String    @db.VarChar(16)
  providerAccountFingerprint String    @map("provider_account_fingerprint") @db.VarChar(128)
  providerEventId            String    @map("provider_event_id") @db.VarChar(255)
  normalizationVersion       String    @map("normalization_version") @db.VarChar(100)
  eventType                  String    @map("event_type") @db.VarChar(40)
  providerObjectId           String    @map("provider_object_id") @db.VarChar(255)
  payloadDigest              Bytes     @map("payload_digest")
  signatureTimestampSeconds  BigInt    @map("signature_timestamp_seconds")
  verifierVersion            String    @map("verifier_version") @db.VarChar(100)
  providerOccurredAt         DateTime  @map("provider_occurred_at") @db.Timestamptz(6)
  receivedAt                 DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  claimedOrderPublicId       String    @map("claimed_order_public_id") @db.Uuid
  orderId                    String?   @map("order_id") @db.Uuid
  paymentAttemptId           String?   @map("payment_attempt_id") @db.Uuid
  providerCheckoutId         String?   @map("provider_checkout_id") @db.VarChar(255)
  providerPaymentIntentId    String?   @map("provider_payment_intent_id") @db.VarChar(255)
  amountMinor                Int       @map("amount_minor")
  currencyCode               String    @map("currency_code") @db.Char(3)
  validationState            String    @default("received") @map("validation_state") @db.VarChar(24)
  processingState            String    @default("pending") @map("processing_state") @db.VarChar(24)
  processingDisposition      String?   @map("processing_disposition") @db.VarChar(32)
  processedAt                DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, environment, providerAccountFingerprint, providerEventId], map: "commercial_payment_event_v2_provider_event_key")
  @@unique([id, orderId, paymentAttemptId], map: "commercial_payment_event_v2_outbox_identity_key")
  @@index([orderId, providerOccurredAt, eventType, providerEventId], map: "commercial_payment_event_v2_order_timeline_idx")
  @@index([processingState, receivedAt, id], map: "commercial_payment_event_v2_processing_idx")
  @@map("commercial_payment_event_v2")
}

model CommercialPaymentOutboxV2 {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentEventId      String    @unique(map: "commercial_payment_outbox_v2_event_key") @map("payment_event_id") @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  paymentAttemptId    String    @map("payment_attempt_id") @db.Uuid
  topic               String    @db.VarChar(100)
  schemaVersion       String    @map("schema_version") @db.VarChar(100)
  orderStatus         String    @map("order_status") @db.VarChar(24)
  paymentAttemptState String    @map("payment_attempt_state") @db.VarChar(24)
  paymentStateVersion Int       @map("payment_state_version")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveryState       String    @default("pending") @map("delivery_state") @db.VarChar(24)
  attemptCount        Int       @default(0) @map("attempt_count") @db.SmallInt
  availableAt         DateTime  @map("available_at") @db.Timestamptz(6)
  leaseTokenHash      Bytes?    @map("lease_token_hash")
  leasedUntil         DateTime? @map("leased_until") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  lastFailureCode     String?   @map("last_failure_code") @db.VarChar(100)
  deadLetteredAt      DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([deliveryState, availableAt, createdAt, id], map: "commercial_payment_outbox_v2_delivery_idx")
  @@map("commercial_payment_outbox_v2")
}

model CreditReservation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  catalogVersion        String    @map("catalog_version") @db.VarChar(100)
  productCode           String    @map("product_code") @db.VarChar(100)
  productVersion        String    @map("product_version") @db.VarChar(100)
  amount                Int
  status                String    @default("active") @db.VarChar(16)
  idempotencyKeyVersion String    @map("idempotency_key_version") @db.VarChar(100)
  idempotencyKeyHash    Bytes     @map("idempotency_key_hash")
  canonicalRequestHash  Bytes     @map("canonical_request_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)
  releasedAt            DateTime? @map("released_at") @db.Timestamptz(6)
  expiredAt             DateTime? @map("expired_at") @db.Timestamptz(6)

  @@unique([userId, idempotencyKeyVersion, idempotencyKeyHash], map: "credit_reservation_user_idempotency_key")
  @@unique([id, userId], map: "credit_reservation_id_user_key")
  @@index([userId, status, expiresAt, id], map: "credit_reservation_user_status_idx")
  @@map("credit_reservation")
}

model CreditLedgerEntry {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  creditType            String    @map("credit_type") @db.VarChar(24)
  direction             String    @db.VarChar(16)
  amount                Int
  reason                String    @db.VarChar(100)
  catalogVersion        String?   @map("catalog_version") @db.VarChar(100)
  productCode           String?   @map("product_code") @db.VarChar(100)
  productVersion        String?   @map("product_version") @db.VarChar(100)
  orderId               String?   @map("order_id") @db.Uuid
  subscriptionPeriodId  String?   @map("subscription_period_id") @db.VarChar(200)
  reservationId         String?   @map("reservation_id") @db.Uuid
