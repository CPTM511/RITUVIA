}

model CommercialFulfillmentV2 {
  orderId                    String   @id @map("order_id") @db.Uuid
  userId                     String   @map("user_id") @db.Uuid
  fulfillmentKind            String   @map("fulfillment_kind") @db.VarChar(24)
  fulfillmentCode            String   @map("fulfillment_code") @db.VarChar(100)
  sourceGrantEntryId         String   @map("source_grant_entry_id") @db.Uuid
  status                     String   @db.VarChar(24)
  grantedAmount              Int      @map("granted_amount")
  heldAmount                 Int      @map("held_amount")
  reversedAmount             Int      @map("reversed_amount")
  shortfallAmount            Int      @map("shortfall_amount")
  appliedPaymentStateVersion Int      @map("applied_payment_state_version")
  lastOutboxId               String   @unique(map: "commercial_fulfillment_v2_last_outbox_key") @map("last_outbox_id") @db.Uuid
