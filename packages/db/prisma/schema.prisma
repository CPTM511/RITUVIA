  @@unique([userId, operation, idempotencyKeyVersion, idempotencyKeyHash], map: "credit_ledger_entry_user_idempotency_key")
  @@unique([id, userId], map: "credit_ledger_entry_id_user_key")
  @@index([userId, createdAt, id], map: "credit_ledger_entry_user_created_idx")
  @@index([sourceEntryId, id], map: "credit_ledger_entry_source_idx")
