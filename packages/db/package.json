{
  "name": "@rituvia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "db:local:reset": "node scripts/manage-development-database.mjs reset",
    "db:local:setup": "node scripts/manage-development-database.mjs setup",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:url": "node scripts/local-postgres.mjs url",
    "generate": "prisma generate",
    "test:account-merge": "node --import tsx scripts/verify-account-merge.ts",
    "test:account-control": "node --import tsx scripts/verify-account-control.ts",
    "test:account-consent": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-account-consent.ts",
    "test:astrology-calculation": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-astrology-calculation-persistence.ts",
    "test:birth-profile": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-birth-profile-persistence.ts",
    "test:revisit-reminder": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-revisit-reminder.ts",
    "test:privacy-export": "node --import tsx scripts/verify-privacy-export.ts",
    "test:privacy-deletion": "node --import tsx scripts/verify-privacy-deletion.ts",
    "test:admin-security": "pnpm --filter @rituvia/security build && node --import tsx scripts/verify-admin-security.ts",
    "test:astrology-kill-switch": "node --import tsx scripts/verify-astrology-kill-switch.ts",
    "test:backup-recovery": "pnpm --filter @rituvia/domain build && pnpm generate && node --import tsx scripts/verify-backup-recovery.ts",
    "test:ci": "pnpm --filter @rituvia/domain build && pnpm --filter @rituvia/security build && pnpm generate && node --import tsx scripts/verify-ci-foundation.ts",
    "test:catalog": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-catalog.ts",
    "test:commercial-transactions": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-commercial-transactions.ts",
    "test:commercial-checkout": "pnpm --filter @rituvia/domain build && node --import tsx scripts/verify-commercial-checkout.ts",
    "test:commercial-fulfillment": "node --import tsx ../../tests/verify-commercial-fulfillment.ts",
    "test:commercial-reconciliation": "node --import tsx ../../tests/verify-commercial-reconciliation.ts",
    "test:country-policy": "node --import tsx scripts/verify-country-policy.ts",
    "test:integration": "pnpm --filter @rituvia/domain build && pnpm generate && node scripts/verify-foundation.mjs && node --import tsx scripts/verify-anonymous-identity.ts && node --import tsx scripts/verify-tarot-reading-persistence.ts && node --import tsx scripts/verify-intention-persistence.ts && node --import tsx scripts/verify-ritual-journal-persistence.ts && node --import tsx scripts/verify-revisit-persistence.ts",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@rituvia/domain": "workspace:*",
    "@rituvia/security": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "prisma": "7.8.0"
  }
}
