{
  "name": "@rituvia/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles.css",
    "./dist/styles.css",
    "./dist/styles.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./src/styles.ts",
      "import": "./dist/styles.js",
      "default": "./dist/styles.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/copy-ui-styles.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
