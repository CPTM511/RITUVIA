{
  "name": "@rituvia/payments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./adapters/local": {
      "types": "./src/adapters/local-hosted-checkout.ts",
      "import": "./dist/adapters/local-hosted-checkout.js"
    },
    "./adapters/stripe": {
      "types": "./src/adapters/stripe-hosted-checkout.ts",
      "import": "./dist/adapters/stripe-hosted-checkout.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rituvia/domain": "workspace:*"
  }
}
