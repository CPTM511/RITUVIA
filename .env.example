# Deployment classification. Allowed values: local, preview, staging, production.
APP_ENV=

# Optional working-brand overrides. Empty values use the local typed defaults.
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_LEGAL_ENTITY=
BRAND_TAGLINE=
BRAND_CANONICAL_ORIGIN=
BRAND_SUPPORT_EMAIL=
BRAND_TRANSACTIONAL_SENDER=
BRAND_SOCIAL_HANDLES=
BRAND_ASSET_MANIFEST=

# Optional database connections. PAYMENT_WEBHOOK_DATABASE_URL must use the dedicated least-
# privilege webhook role; only that role may apply verified payment state, Credits, entitlements,
# subscriptions, and commerce audit records within its exact grants.
DATABASE_URL=
AI_GENERATION_DATABASE_URL=
# Protected staging Item 11 only: derives the exact rituvia_ai_generation connection from
# DATABASE_URL. Vercel OIDC is automatic; no static AI Gateway or provider API key is accepted.
RITUVIA_AI_GENERATION_ROLE_PASSWORD=
PAYMENT_WEBHOOK_DATABASE_URL=
# Protected staging Item 10 only: derives the exact rituvia_payment_webhook connection from
# DATABASE_URL without exposing an administrator connection to the runtime.
RITUVIA_PAYMENT_WEBHOOK_ROLE_PASSWORD=
# Privacy deletion role configuration follows.
PRIVACY_DELETION_DATABASE_URL=
# Protected staging only: derives the exact rituvia_privacy_deletion connection from DATABASE_URL.
RITUVIA_PRIVACY_DELETION_ROLE_PASSWORD=

# Native astrology remains safe-off in the feature registry. When enabled in an approved
# environment, this must be the absolute path to checksum-attested production build metadata.
RITUVIA_ASTROLOGY_NATIVE_BUILD_METADATA_PATH=

# Anonymous sessions remain disabled unless all four values are configured. Production policy
# versions must reference the approved retention/legal decision with an `own-004.` prefix.
RITUVIA_ANONYMOUS_SESSION_ISSUANCE_LIMIT=
RITUVIA_ANONYMOUS_SESSION_ISSUANCE_WINDOW_SECONDS=
RITUVIA_ANONYMOUS_SESSION_POLICY_VERSION=
RITUVIA_ANONYMOUS_SESSION_TTL_SECONDS=

# Local/passwordless account foundation. Keys are 32 random bytes encoded as base64url
# (43 characters, no padding). Local sign-in links are never enabled outside APP_ENV=local.
RITUVIA_ACCOUNT_SESSION_TTL_SECONDS=
RITUVIA_AUTH_CHALLENGE_TTL_SECONDS=
RITUVIA_AUTH_DATA_KEY_V1=
RITUVIA_AUTH_START_GLOBAL_LIMIT=
RITUVIA_AUTH_START_IDENTIFIER_LIMIT=
RITUVIA_AUTH_START_WINDOW_SECONDS=
RITUVIA_AUTH_SUBJECT_HMAC_KEY_V1=

# Protected recovery staging Item 11 only. These fixed caps and provider credentials remain
# rejected outside APP_ENV=staging and do not authorize real assets, custody, production AI,
# DNS, or public release.
RITUVIA_AI_DAILY_USER_LIMIT=
RITUVIA_AI_GATEWAY_MODEL=
RITUVIA_AI_MAX_COST_MICROS=
RITUVIA_AI_MAX_OUTPUT_TOKENS=
RITUVIA_AI_TIMEOUT_MS=
RITUVIA_COINBASE_API_KEY_ID=
RITUVIA_COINBASE_API_KEY_SECRET=
RITUVIA_COINBASE_WEBHOOK_SECRET=

# Protected recovery staging only. This activates the Item 9 email sandbox and Base Sepolia
# SIWE identity boundary; it is rejected outside staging and does not activate an email provider.
RITUVIA_RECOVERY_IDENTITY_SANDBOX=

# Protected recovery staging Item 11 only. Activates Coinbase Business Sandbox USDC on Base and
# one synthetic Provider AI flow under the fixed caps above.
RITUVIA_RECOVERY_ITEM_11_SANDBOX=

# Protected recovery staging only. This activates the Item 10 Stripe Test commerce boundary and is
# rejected outside APP_ENV=staging. It does not authorize live Stripe, real funds, or Production.
RITUVIA_RECOVERY_COMMERCE_SANDBOX=

# Local signed hosted-checkout simulation. This adapter is rejected outside APP_ENV=local.
RITUVIA_LOCAL_CHECKOUT_SIGNING_SECRET_V1=
RITUVIA_PAYMENT_PROVIDER=

# Privacy deletion stays safe-off until both recent-authentication and rate windows are configured.
RITUVIA_PRIVACY_DELETION_RECENT_AUTH_SECONDS=
RITUVIA_PRIVACY_DELETION_REQUEST_WINDOW_SECONDS=

# Privacy exports use a dedicated 32-byte key and explicit operational expiry/rate windows.
RITUVIA_PRIVACY_EXPORT_KEY_V1=
RITUVIA_PRIVACY_EXPORT_RECENT_AUTH_SECONDS=
RITUVIA_PRIVACY_EXPORT_REQUEST_WINDOW_SECONDS=
RITUVIA_PRIVACY_EXPORT_TTL_SECONDS=

# Encrypt private small actions and journal reflections before persistence.
RITUVIA_PRIVATE_CONTENT_KEY_V1=

# Safe-off private question-intake preview. Production activation requires the exact approved
# owner decision reference with an `own-009.` prefix; leave empty until that decision is accepted.
RITUVIA_QUESTION_INTAKE_ACTIVATION_REFERENCE=

RITUVIA_REFLECTION_POLICY_VERSION=
RITUVIA_REFLECTION_RETENTION_SECONDS=
RITUVIA_REFLECTION_REVISIT_DELAY_SECONDS=

# Stripe Hosted Checkout remains safe-off until securely supplied Test Mode secrets, exact test
# Price IDs for pack_6, pack_15, pack_40, plus_monthly, and plus_annual, and an approved sandbox
# country/payment policy are present. Live keys remain rejected. Never expose these values through
# NEXT_PUBLIC_* variables.
RITUVIA_STRIPE_ACCOUNT_ID=
RITUVIA_STRIPE_PRICE_IDS=

# Deterministic draw integrity. Use a different 32-byte base64url key from every other key.
RITUVIA_TAROT_INTEGRITY_KEY_V1=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local tooling also accepts RITUVIA_LOCAL_POSTGRES_PORT when the default port is occupied.
