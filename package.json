{
  "name": "rituvia",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "build": "turbo run build && node scripts/verify-workspace-build.mjs",
    "check": "pnpm check:evidence && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:ai-operations": "pnpm --filter @rituvia/observability build && node --import tsx scripts/verify-ai-operations.ts",
    "check:architecture": "node --import tsx scripts/verify-architecture.ts",
    "check:ci-contract": "node --import tsx scripts/verify-ci-contract.ts",
    "check:environment-contract": "node --import tsx scripts/verify-environment-contract.ts",
    "check:evidence": "pnpm check:ci-contract && pnpm check:architecture && pnpm check:environment-contract && pnpm check:ai-operations && pnpm check:localization && pnpm check:editorial-content && pnpm check:public-pages && pnpm check:search-operations && pnpm check:rtl && pnpm check:writing-systems && pnpm check:records && pnpm check:migrations && pnpm check:generated && pnpm scan:secrets",
    "check:generated": "python3 -B scripts/sync_generated_evidence.py --check && python3 -B scripts/validate_instruction_pack.py",
    "check:editorial-content": "pnpm --filter @rituvia/i18n build && node --import tsx scripts/verify-editorial-content.ts",
    "check:localization": "node scripts/verify-localization-workflow.mjs",
    "check:public-pages": "node --import tsx scripts/verify-public-page-quality.ts",
    "check:search-operations": "node --import tsx scripts/verify-search-operations.ts",
    "check:rtl": "node --import tsx scripts/verify-rtl.ts",
    "check:writing-systems": "node --import tsx scripts/verify-writing-systems.ts",
    "check:migrations": "node --import tsx scripts/verify-migration-policy.ts",
    "check:records": "python3 -B scripts/build_record_index.py --check && node --import tsx scripts/verify-records.ts",
    "db:reset": "pnpm --filter @rituvia/db db:local:reset",
    "db:setup": "pnpm --filter @rituvia/db db:local:setup",
    "db:start": "pnpm --filter @rituvia/db db:local:start",
    "db:status": "pnpm --filter @rituvia/db db:local:status",
    "db:stop": "pnpm --filter @rituvia/db db:local:stop",
    "db:url": "pnpm --filter @rituvia/db db:local:url",
    "dev": "turbo run dev",
    "format": "prettier --write package.json pnpm-workspace.yaml turbo.json tsconfig.json tsconfig.base.json eslint.config.mjs prettier.config.mjs vitest.config.ts \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"apps/**/*.{ts,tsx,mjs,json,css}\" \"packages/**/*.{ts,tsx,mjs,json,css}\" \"content/**/*.json\" \".github/workflows/*.{yml,yaml}\" \".github/codex/workflow-examples/*.{yml,yaml}\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml turbo.json tsconfig.json tsconfig.base.json eslint.config.mjs prettier.config.mjs vitest.config.ts \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"apps/**/*.{ts,tsx,mjs,json,css}\" \"packages/**/*.{ts,tsx,mjs,json,css}\" \"content/**/*.json\" \".github/workflows/*.{yml,yaml}\" \".github/codex/workflow-examples/*.{yml,yaml}\"",
    "lint": "eslint eslint.config.mjs prettier.config.mjs vitest.config.ts scripts tests apps packages --max-warnings=0",
    "mvp:local:configure": "node scripts/configure-local-mvp.mjs",
    "report:ai-operations": "node --import tsx scripts/generate-ai-operations-report.ts",
    "report:search-operations": "node --import tsx scripts/generate-search-operations-report.ts",
    "scan:secrets": "node --import tsx scripts/scan-secrets.ts",
    "test": "pnpm test:unit && pnpm test:ai-evals && pnpm test:configuration-boundary && pnpm test:database-foundation",
    "test:accessibility": "pnpm --filter @rituvia/i18n build && node scripts/verify-full-loop-browser.mjs && node scripts/verify-web-accessibility.mjs && node scripts/verify-intention-browser.mjs && node scripts/verify-ritual-browser.mjs && node scripts/verify-revisit-browser.mjs && node scripts/verify-writing-systems-browser.mjs",
    "test:astrology-native": "pnpm --filter @rituvia/astrology-engine-native native:verify",
    "test:astrology-native-corresponding-source": "pnpm --filter @rituvia/astrology-engine-native native:verify-corresponding-source",
    "test:astrology-native-sca": "pnpm --filter @rituvia/astrology-engine-native native:verify-sca",
    "test:astrology-native-security": "pnpm --filter @rituvia/astrology-engine-native native:verify-security",
    "test:account-merge-database": "pnpm --filter @rituvia/db test:account-merge",
    "test:account-control-database": "pnpm --filter @rituvia/db test:account-control",
    "test:account-consent-database": "pnpm --filter @rituvia/db test:account-consent",
    "test:revisit-reminder-database": "pnpm --filter @rituvia/db test:revisit-reminder",
    "test:privacy-export-database": "pnpm --filter @rituvia/db test:privacy-export",
    "test:privacy-deletion-database": "pnpm --filter @rituvia/db test:privacy-deletion",
    "test:admin-security-database": "pnpm --filter @rituvia/db test:admin-security",
    "test:account-auth-browser": "node scripts/verify-account-auth-browser.mjs",
    "test:astrology-browser": "node scripts/verify-astrology-browser.mjs",
    "test:astrology-seo-browser": "node scripts/verify-astrology-seo-browser.mjs",
    "test:account-control-browser": "node scripts/verify-account-control-browser.mjs",
    "test:privacy-control-browser": "node scripts/verify-privacy-control-browser.mjs",
    "test:public-search-browser": "node --import tsx scripts/verify-public-search-browser.mjs",
    "test:release-corresponding-source": "node scripts/verify-release-corresponding-source.mjs",
    "test:ai-evals": "node --import tsx scripts/verify-ai-release-evals.ts",
    "test:astrology-ai-evals": "node --import tsx scripts/verify-astrology-ai-release-evals.ts",
    "test:numerology-ai-evals": "node --import tsx scripts/verify-numerology-ai-release-evals.ts",
    "test:numerology-seo-browser": "node scripts/verify-numerology-seo-browser.mjs",
    "test:tarot-seo-browser": "node scripts/verify-tarot-seo-browser.mjs",
    "test:tarot-share-browser": "node scripts/verify-tarot-share-browser.mjs",
    "test:ritual-reflection-seo-browser": "node scripts/verify-ritual-reflection-seo-browser.mjs",
    "test:configuration-boundary": "node scripts/verify-configuration-boundary.mjs",
    "test:catalog-database": "pnpm --filter @rituvia/db test:catalog",
    "test:commercial-transactions-database": "pnpm --filter @rituvia/db test:commercial-transactions",
    "test:commercial-checkout-database": "pnpm --filter @rituvia/db test:commercial-checkout",
    "test:commercial-fulfillment-database": "pnpm --filter @rituvia/db test:commercial-fulfillment",
    "test:commercial-reconciliation-database": "pnpm --filter @rituvia/db test:commercial-reconciliation",
    "test:commercial-refund-database": "pnpm --filter @rituvia/db test:commercial-refund",
    "test:commercial-payment-webhook-database": "pnpm --filter @rituvia/db generate && node --import tsx tests/verify-commercial-payment-webhook.ts",
    "test:country-policy-database": "pnpm --filter @rituvia/db test:country-policy",
    "test:identity-privacy-authorization": "node scripts/verify-identity-privacy-authorization.mjs",
    "test:full-loop-browser": "node scripts/verify-full-loop-browser.mjs",
    "test:intention-browser": "node scripts/verify-intention-browser.mjs",
    "test:numerology-browser": "node scripts/verify-numerology-browser.mjs",
    "test:ritual-browser": "node scripts/verify-ritual-browser.mjs",
    "test:revisit-browser": "node scripts/verify-revisit-browser.mjs",
    "test:writing-systems-browser": "node scripts/verify-writing-systems-browser.mjs",
    "test:lifecycle-message-preview": "node --import tsx scripts/verify-lifecycle-message-preview.ts",
    "test:backup-recovery-database": "pnpm --filter @rituvia/db test:backup-recovery",
    "test:ci-database": "pnpm --filter @rituvia/db test:ci",
    "test:database-foundation": "pnpm --filter @rituvia/db test:integration",
    "test:list": "vitest list --filesOnly",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/env": "16.2.11",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.61.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
