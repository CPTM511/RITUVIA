{
  "name": "@rituvia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "pnpm --filter @rituvia/astrology-engine-native native:prepare -- --allow-download",
    "start": "node start.mjs",
    "typecheck": "node ../../scripts/remove-next-type-duplicates.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "16.2.11",
    "@rituvia/ai": "workspace:*",
    "@rituvia/analytics": "workspace:*",
    "@rituvia/astrology-engine-native": "workspace:*",
    "@rituvia/config": "workspace:*",
    "@rituvia/country-policy": "workspace:*",
    "@rituvia/db": "workspace:*",
    "@rituvia/divination": "workspace:*",
    "@rituvia/domain": "workspace:*",
    "@rituvia/i18n": "workspace:*",
    "@rituvia/observability": "workspace:*",
    "@rituvia/payments": "workspace:*",
    "@rituvia/ui": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
