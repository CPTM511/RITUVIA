{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "APP_ENV",
        "BRAND_ASSET_MANIFEST",
        "BRAND_CANONICAL_ORIGIN",
        "BRAND_LEGAL_ENTITY",
        "BRAND_NAME",
        "BRAND_SHORT_NAME",
        "BRAND_SOCIAL_HANDLES",
        "BRAND_SUPPORT_EMAIL",
        "BRAND_TAGLINE",
        "BRAND_TRANSACTIONAL_SENDER",
        "RITUVIA_BUILD_SOURCE_SHA"
      ],
      "outputs": ["dist/**", "src/generated/prisma/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
